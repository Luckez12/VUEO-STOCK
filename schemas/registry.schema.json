{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VUEO Provider Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providers"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "providers": {
      "type": "array"
    }
  }
}
